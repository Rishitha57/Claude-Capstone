{
  "mcpServers": {
    "sdlc-workflow-engine": {
      "command": "python",
      "args": ["scripts/sdlc_mcp_server.py"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "jira": {
      "command": "npx",
      "args": ["-y", "@atlassian/mcp-jira"]
    },
    "confluence": {
      "command": "npx",
      "args": ["-y", "@atlassian/mcp-confluence"]
    }
  }
}
